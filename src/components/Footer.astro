---
import { contactHref, secondaryNav, socialLinks } from '../lib/site';
import Separator from './Separator.astro';
---

<footer class="shell border-t hairline pt-1.5 pb-6">
	<div class="flex flex-wrap items-center gap-x-2.5 gap-y-2 text-xs lowercase text-subtle sm:text-sm">
		{secondaryNav.map((item) => (
			<a class="transition hover:text-link" href={item.href}>{item.label}</a>
		))}
		<Separator char="|" class="text-line" />
		{socialLinks.map((item, index) => (
			<>
				{index > 0 && <Separator class="text-line" />}
				<a class="transition hover:text-link" href={item.href}>{item.label}</a>
			</>
		))}
		<Separator class="text-line" />
		<a class="transition hover:text-link" href={contactHref} data-mail>email</a>
	</div>
</footer>
