---
import { ArrowUpRight } from '@lucide/astro';

type Props = {
	title: string;
	href?: string;
	linkLabel?: string;
};

const { title, href, linkLabel } = Astro.props;
---

<div class="mb-7 flex items-end justify-between gap-2.5 sm:mb-9">
	<h2 class="section-title">{title}</h2>
	{href && linkLabel && (
		<a href={href} class="group inline-flex items-center gap-1 text-sm text-accent transition hover:text-text sm:text-base">
			{linkLabel} <ArrowUpRight size={18} class="transition group-hover:-translate-y-0.5 group-hover:translate-x-0.5" />
		</a>
	)}
</div>
