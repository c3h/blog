---
import ArrowLink from './ArrowLink.astro';

type Props = {
	title: string;
	href?: string;
	linkLabel?: string;
	/** sem a margem de baixo: para o título que não tem conteúdo depois */
	flush?: boolean;
};

const { title, href, linkLabel, flush = false } = Astro.props;
---

<div class:list={['flex items-end justify-between gap-2.5', !flush && 'mb-7 sm:mb-9']}>
	<h2 class="section-title">{title}</h2>
	<slot name="actions" />
	{href && linkLabel && <ArrowLink href={href} label={linkLabel} shortLabel="ver mais" />}
</div>
