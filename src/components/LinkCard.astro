---
import { ArrowUpRight } from '@lucide/astro';

type Props = {
	title: string;
	meta: string;
	description: string;
	href?: string;
	headingLevel?: 'h2' | 'h3';
	revealArrowOnHover?: boolean;
	pills?: readonly string[];
};

const {
	title,
	meta,
	description,
	href,
	headingLevel: Heading = 'h2',
	revealArrowOnHover = false,
	pills,
} = Astro.props;
const Tag = href ? 'a' : 'div';
const linkProps = href ? { href, target: '_blank', rel: 'noreferrer' } : {};
---

<Tag
	{...linkProps}
	class:list={[
		'link-card group -mx-3.5 block rounded-md px-3.5 py-4 transition focus:outline-none focus-visible:outline-none',
		!href && 'cursor-default',
	]}
>
	<div class="flex items-start justify-between gap-2.5">
		<Heading
			class:list={[
				'text-lg font-semibold text-text transition sm:text-[1.25rem]',
				href && 'group-hover:text-accent group-focus-visible:text-accent',
			]}
		>
			{title}
		</Heading>
		{href && (
			<ArrowUpRight
				size={20}
				class:list={[
					'mt-1 shrink-0 text-subtle transition group-hover:-translate-y-0.5 group-hover:translate-x-0.5 group-hover:text-accent group-focus-visible:-translate-y-0.5 group-focus-visible:translate-x-0.5 group-focus-visible:text-accent',
					revealArrowOnHover && 'opacity-0 group-hover:opacity-100 group-focus-visible:opacity-100',
				]}
			/>
		)}
	</div>
	<p class="mt-1 text-xs text-subtle sm:text-sm">{meta}</p>
	<p class="mt-2.5 text-sm leading-5.5 text-muted sm:text-base">{description}</p>
	{pills && pills.length > 0 && (
		<div class="mt-3.5 flex flex-wrap gap-1.5">
			{pills.map((pill) => (
				<span class="bg-panel px-2 py-1 text-[0.5rem] text-subtle sm:text-xs">{pill}</span>
			))}
		</div>
	)}
</Tag>

<style>
	.link-card {
		background: transparent;
	}
	a.link-card:hover,
	a.link-card:focus-visible {
		background: color-mix(in srgb, var(--accent) 5%, transparent);
	}
	:root[data-theme='light'] a.link-card:hover,
	:root[data-theme='light'] a.link-card:focus-visible {
		background: color-mix(in srgb, var(--accent) 4%, transparent);
	}
</style>
