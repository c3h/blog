---
import { Moon, Search, Sun, SunMoon } from '@lucide/astro';
import { navItems } from '../lib/site';

const currentPath = Astro.url.pathname;
---

<header class="shell pt-5 sm:pt-7">
	<nav class="flex items-center justify-between gap-3.5 font-mono" aria-label="Navegação principal">
		<div class="flex flex-wrap items-center gap-x-4 gap-y-1.5">
			{navItems.map((item) => {
				const active = item.href === '/' ? currentPath === '/' : currentPath.startsWith(item.href);
				return (
					<a
						href={item.href}
						aria-current={active ? 'page' : undefined}
						class:list={[
							'group text-sm transition sm:text-base',
							active ? 'text-accent' : 'text-muted hover:text-accent',
						]}
					>
						<span class="hidden text-subtle transition group-hover:text-text sm:inline">[{item.key}]</span>{' '}
						<span>{item.label}</span>
					</a>
				);
			})}
		</div>
		<div class="flex items-center gap-1.5">
			<button
				type="button"
				data-command-open
				class="inline-flex h-7 items-center gap-1.5 rounded-md px-1.5 text-xs text-subtle transition hover:bg-panel hover:text-accent"
				aria-label="Abrir busca"
				title="Pressione / para buscar"
			>
				<Search size={16} class="sm:hidden" />
				<kbd class="kbd hidden sm:inline">/</kbd>
				<span class="hidden sm:inline">buscar</span>
			</button>
			<button
				type="button"
				data-theme-toggle
				class="theme-toggle inline-grid size-7 place-items-center rounded-md text-muted transition hover:bg-panel hover:text-accent"
				aria-label="Alternar tema"
			>
				<SunMoon size={16} data-theme-icon="system" />
				<Sun size={16} data-theme-icon="light" />
				<Moon size={16} data-theme-icon="dark" />
			</button>
		</div>
	</nav>
</header>

<script>
	const normalize = (path: string) => (path.length > 1 && path.endsWith('/') ? path.slice(0, -1) : path);

	document.querySelectorAll<HTMLAnchorElement>('nav a[href]').forEach((link) => {
		link.addEventListener('click', (event) => {
			const url = new URL(link.href, window.location.origin);
			if (normalize(url.pathname) !== normalize(window.location.pathname)) return;

			const target = document.querySelector<HTMLElement>('[data-decrypt]');
			if (!target) return;

			event.preventDefault();
			document.dispatchEvent(new CustomEvent('decrypt:replay', { detail: target }));
		});
	});
</script>
