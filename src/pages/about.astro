---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import ArrowLink from '../components/ArrowLink.astro';
import Section from '../components/Section.astro';
import { careerEntries } from '../data/career';
import { projects } from '../data/projects';
import { publications } from '../data/publications';
import { mailParts, phoneParts } from '../lib/contact';
import { joinMeta } from '../lib/meta';
import { contactHref, site, socialLinks } from '../lib/site';
import { printUrl } from '../lib/url';

const description =
	'Daniel Gimigliano, engenheiro de software com foco em back-end e produto. Disponível para consultoria e freelas; pesquisa a dinâmica de autômatos celulares.';

/** um link sem destino some em silêncio: o Astro omite o href e sobra um <a> morto. melhor quebrar o build */
const need = (href: string | undefined, what: string) => {
	if (!href) throw new Error(`/about: sem endereço para ${what}`);
	return href;
};

/** o endereço de cada empresa tem uma fonte só: a trajetória */
const orgHref = (id: string) => need(careerEntries.find((entry) => entry.id === id)?.orgHref, id);

/** por onde passei, na ordem em que aconteceu. o nome é o de conversa, não a razão social */
const before = [
	{ label: 'ibgc', href: orgHref('e-ibgc') },
	{ label: 'radix', href: orgHref('e-radix') },
	{ label: 'avita', href: orgHref('e-avita') },
	{ label: 'trybe', href: orgHref('e-trybe') },
	{ label: 'mottu', href: orgHref('e-mottu') },
	{ label: 'metro telworks', href: orgHref('e-metro') },
	{ label: 'sinergyrh', href: orgHref('e-sinergy') },
	{ label: 'capta', href: orgHref('e-capta') },
];

const projectHref = (title: string) => need(projects.find((project) => project.title === title)?.href, title);

const ito = projectHref('ito');
const code = projectHref('eca-adds-analysis');
/** pelo DOI, não pelo ano: uma segunda publicação de 2026 não pode trocar este link */
const PAPER_DOI = '10.1007/978-3-032-18612-6_20';
const paper = need(publications.find((publication) => publication.href?.includes(PAPER_DOI))?.href, 'o artigo');
const pdf = '/daniel-gimigliano-cv.pdf';

const RULES = [30, 90, 110, 150, 184];
const DEFAULT_RULE = 110;

/**
 * Contato por extenso, só no papel. Os perfis são públicos e ficam no HTML;
 * e-mail e telefone entram pelo script ao lado do parágrafo, na hora de
 * imprimir — elemento escondido por CSS continua à vista de raspador.
 */
const printSocial = joinMeta(socialLinks.map((item) => printUrl(item.href)));
---

<BaseLayout title="Sobre" description={description}>
	{/* marca a página como interativa antes do primeiro paint: sem JS o autômato
	    não desenha, então nem os controles nem a figura ocupam espaço */}
	<script is:inline>document.documentElement.dataset.js = '1';</script>

	<div class="about">
		<PageHeader title="sobre">
			<div class="now">
				<p>
					sou engenheiro de software, de back-end e produto. gosto de acompanhar um sistema da
					concepção até a produção, de preferência em times pequenos.
				</p>
				<p>
					hoje construo um produto próprio, que ainda não foi a público, e nas horas vagas o
					<a class="link-inline" href={ito} data-print-url={printUrl(ito)}>ito</a>, um issue tracker para terminal. também curso o doutorado em
					engenharia elétrica e computação na mackenzie.
				</p>
				<p>
					{/* numa linha só: quebra entre os fragmentos viraria espaço antes da vírgula */}
					antes disso:{' '}
					{before.map((item, index) => (<>{index > 0 && (index === before.length - 1 ? ' e ' : ', ')}<a class="link-inline" href={item.href}>{item.label}</a></>))}. o detalhe de cada passagem está no
					<a class="link-inline" href={pdf} download data-print-url={printUrl(site.url + pdf)}>currículo em pdf</a>.
				</p>
			</div>

			{/* o único ponto de contato direto da página; o rodapé do site aponta para cá */}
			<div class="actions" id="contato">
				<p class="avail">
					<span class="pip" aria-hidden="true"></span>
					<span>disponível para consultoria e freelas de back-end, remoto</span>
				</p>
				{/* vira mailto no primeiro gesto — o script fica no BaseLayout */}
				<ArrowLink class="cta" href={contactHref} data-mail label="me escrever" />
				<noscript>
					<p>para me escrever: {mailParts.user} [arroba] {mailParts.domain}</p>
				</noscript>
				<p class="where">engenheiro coelho, sp · pt-br nativo · en profissional</p>
				<p class="hidden print:block" data-print-contact>{printSocial}</p>
				<script is:inline define:vars={{ mail: mailParts, phone: phoneParts }}>
					const contact = document.querySelector('[data-print-contact]');
					const social = contact.textContent;
					window.addEventListener('beforeprint', () => {
						contact.textContent = [[mail.user, mail.domain].join('@'), phone.join('-'), social].join(' · ');
					});
					window.addEventListener('afterprint', () => {
						contact.textContent = social;
					});
				</script>
			</div>
		</PageHeader>

		<Section title="o que eu pesquiso">
			<div class="research">
				<p>
					no mestrado estudei autômatos celulares elementares: fileiras de células que mudam de estado
					olhando só para si e para as duas vizinhas. a pergunta era o que acontece com a dinâmica quando as
					células deixam de atualizar todas ao mesmo tempo.
				</p>
				<p>
					{/* sem JS não há figura abaixo, e a frase que aponta para ela some junto */}
					<span class="js-only">abaixo, a mesma regra e o mesmo início, nas duas situações.</span>
					o <a class="link-inline" href={paper} data-print-url={printUrl(paper)}>artigo</a> saiu pela
					springer e o <a class="link-inline" href={code} data-print-url={printUrl(code)}>código</a> é aberto.
				</p>
			</div>

			{/* o objeto da pesquisa rodando na página: um autômato celular elementar
			    sob atualização síncrona e sob atualização bloco-sequencial, lado a
			    lado. */}
			<div class="ca" id="ca" data-rule={DEFAULT_RULE}>
				<div class="controls">
					<div class="group" role="group" aria-label="regra do autômato">
						<span class="label">regra</span>
						{RULES.map((rule) => (
							<button
								type="button"
								class="chip tabular-nums"
								data-ca-rule={rule}
								aria-pressed={rule === DEFAULT_RULE ? 'true' : 'false'}
							>
								{rule}
							</button>
						))}
					</div>
					<div class="group" role="group" aria-label="estado inicial">
						<span class="label">início</span>
						<button type="button" class="chip" data-ca-start="one" aria-pressed="true">uma célula</button>
						<button type="button" class="chip" data-ca-start="random" aria-pressed="false">aleatório</button>
					</div>
				</div>

				<div class="diagrams">
					<figure>
						<canvas
							data-ca-canvas="sync"
							role="img"
							aria-label="diagrama espaço-tempo do autômato sob atualização síncrona"
							aria-describedby="ca-state"></canvas>
						<figcaption><b>síncrona</b> · todas as células atualizam juntas</figcaption>
					</figure>
					<figure>
						<canvas
							data-ca-canvas="block"
							role="img"
							aria-label="diagrama espaço-tempo do mesmo autômato sob atualização bloco-sequencial"
							aria-describedby="ca-state"></canvas>
						<figcaption><b>bloco-sequencial</b> · primeiro as pares, depois as ímpares</figcaption>
					</figure>
				</div>
				<p class="legend">
					cada linha é um instante; o tempo corre para baixo. a primeira linha é o início, com as
					células ativas em destaque.
				</p>
				{/* o que os diagramas mostram, em palavras: lido por leitor de tela a cada
				    mudança e impresso no papel, onde os controles não existem */}
				<p class="state sr-only print:not-sr-only" id="ca-state"></p>
			</div>
		</Section>

	</div>
</BaseLayout>

<style>
	/* ============================================================
	   /about — uma página curta sobre o presente. Layout, títulos, cores e
	   escala de texto vêm do site: corrido em 14px, metadado em 12px. Aqui
	   fica só o que é desta página: a medida da coluna e o autômato.
	   ============================================================ */
	.about {
		/* uma coluna de leitura só, em rem: a mesma margem direita para o
		   corrido e para o metadado, que têm corpos diferentes */
		--measure: 36rem;
		--ca-on: #8b8e96;
		--ca-off: #1b1b1d;
		/* o --link já escurece no claro, onde o laranja não chega a 3:1
		   contra a célula apagada */
		--ca-seed: var(--link);
		font-size: 0.875rem;
		line-height: 1.625;
		color: var(--muted);
	}
	:global(:root[data-theme='light']) .about {
		--ca-on: #5f6d63;
		--ca-off: #e6ebe7;
	}

	.link-inline {
		transition: text-decoration-color 160ms ease;
	}

	.now {
		margin-top: 1.5rem;
		max-width: var(--measure);
		display: grid;
		gap: 0.9rem;
	}

	.actions {
		margin-top: 2rem;
		display: grid;
		gap: 0.5rem;
		justify-items: start;
	}
	.avail {
		max-width: var(--measure);
		display: flex;
		gap: 0.7rem;
		align-items: flex-start;
	}
	.pip {
		flex-shrink: 0;
		margin-top: 0.55em;
		width: 0.5rem;
		height: 0.5rem;
		background: var(--accent);
	}
	/* o link de ação do site, com o que é só deste: corpo do texto corrido,
	   peso e altura de botão — é o único contato direto da página */
	.cta {
		min-height: 2.25rem;
		font-size: inherit;
		line-height: inherit;
		font-weight: 600;
	}
	.cta:active {
		transform: scale(0.97);
	}

	.research {
		margin-top: -1rem;
		max-width: var(--measure);
		display: grid;
		gap: 0.75rem;
	}

	/* ---------- o autômato ---------- */
	.ca {
		margin-top: 2rem;
	}
	.controls {
		display: flex;
		flex-wrap: wrap;
		gap: 0.6rem 2rem;
		font-size: 0.75rem;
	}
	.group {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.25rem;
	}
	.label {
		margin-right: 0.4rem;
		color: var(--subtle);
	}
	.chip {
		min-height: 2rem;
		padding: 0 0.6rem;
		border: 1px solid transparent;
		color: var(--muted);
		cursor: pointer;
		transition:
			color 160ms ease,
			border-color 160ms ease,
			transform 120ms cubic-bezier(0.23, 1, 0.32, 1);
	}
	/* a borda carrega o estado, não só o matiz do texto */
	.chip[aria-pressed='true'] {
		border-color: var(--link);
		color: var(--link);
	}
	.chip:active {
		transform: scale(0.97);
	}

	.diagrams {
		margin-top: 1.25rem;
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		gap: 1.75rem;
	}
	@media (width >= 44rem) {
		.diagrams {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			gap: 2rem;
		}
	}
	figure {
		min-width: 0;
	}
	/* a altura é reservada antes do primeiro desenho: 36 linhas de 7px, menos o
	   respiro final. o script confirma o mesmo valor ao desenhar */
	canvas {
		display: block;
		max-width: 100%;
		height: 251px;
	}
	/* sem JS não há o que desenhar: controles não fazem nada, e a legenda sozinha
	   descreveria uma figura ausente. o botão de contato também depende do script;
	   no lugar dele entra o <noscript> */
	:global(:root:not([data-js])) .cta,
	:global(:root:not([data-js])) .controls,
	:global(:root:not([data-js])) .diagrams,
	:global(:root:not([data-js])) .legend,
	:global(:root:not([data-js])) .js-only {
		display: none;
	}
	figcaption,
	.legend,
	.where {
		color: var(--subtle);
		font-size: 0.75rem;
		line-height: 1.5;
	}
	figcaption {
		margin-top: 0.6rem;
	}
	figcaption b {
		color: var(--text);
		font-weight: 600;
	}
	.legend {
		margin-top: 1rem;
		max-width: var(--measure);
	}

	@media (hover: hover) and (pointer: fine) {
		.chip:hover {
			color: var(--text);
		}
	}

	/* no papel o contato são endereços por extenso, e os controles não existem */
	@media print {
		.cta,
		.controls {
			display: none;
		}
		.ca {
			break-inside: avoid;
		}
		/* a4 fica 1px abaixo do ponto de quebra: lado a lado é a comparação */
		.diagrams {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			gap: 1.5rem;
		}
		/* a coluna do papel é mais estreita que a da tela: a altura segue a
		   proporção do canvas em vez da medida fixada pelo script */
		canvas {
			height: auto !important;
		}
		/* na tela é só para leitor de tela (sr-only); no papel vira legenda */
		.state {
			margin-top: 0.5rem;
			color: var(--subtle);
			font-size: 0.75rem;
		}
	}
</style>

<script>
	/**
	 * Autômato celular elementar em anel. A regra é o número de Wolfram; o
	 * modo decide a ordem de atualização:
	 *  - sync:  todas as células leem o instante anterior;
	 *  - block: as pares atualizam primeiro, e as ímpares já leem o resultado.
	 */
	type Mode = 'sync' | 'block';
	type Palette = { on: string; off: string; seed: string };

	const PITCH = 7; // célula de 6px + 1px de respiro
	const CELL = 6;
	const ROWS = 36; // o CSS reserva a altura correspondente
	const REVEAL_MS = 700;
	/** o papel é branco, qualquer que seja o tema da tela */
	const PAPER: Palette = { on: '#888', off: '#eee', seed: '#111' };

	const step = (cells: Uint8Array, rule: number, mode: Mode) => {
		const n = cells.length;
		const cur = cells.slice();
		const f = (i: number) => (rule >> ((cur[(i - 1 + n) % n] << 2) | (cur[i] << 1) | cur[(i + 1) % n])) & 1;
		// cada passada lê tudo antes de escrever: dentro de um bloco a atualização é simultânea
		const pass = (start: number, stride: number) => {
			const out: number[] = [];
			for (let i = start; i < n; i += stride) out.push(f(i));
			for (let i = start, k = 0; i < n; i += stride, k++) cur[i] = out[k];
		};
		if (mode === 'sync') pass(0, 1);
		else {
			pass(0, 2);
			pass(1, 2);
		}
		return cur;
	};

	const root = document.getElementById('ca');
	const state = document.getElementById('ca-state');
	const canvases = Array.from(root?.querySelectorAll<HTMLCanvasElement>('[data-ca-canvas]') ?? []);
	const slotOf = canvases[0]?.parentElement;

	if (root && state && slotOf) {
		const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
		let rule = Number(root.dataset.rule);
		let start: 'one' | 'random' = 'one';
		let seed: Uint8Array | null = null;
		let drawnCols = 0;
		let frame = 0;
		let printing = false;
		/** a revelação é o momento da página: espera o diagrama entrar na tela */
		let seen = false;

		const palette = (): Palette => {
			if (printing) return PAPER;
			const styles = getComputedStyle(root);
			return {
				on: styles.getPropertyValue('--ca-on').trim(),
				off: styles.getPropertyValue('--ca-off').trim(),
				seed: styles.getPropertyValue('--ca-seed').trim(),
			};
		};

		const count = (cells: Uint8Array) => cells.reduce((sum, cell) => sum + cell, 0);

		/** número par de colunas: os dois blocos (pares, ímpares) fecham o anel. 0 quando não cabe */
		const gridCols = () => {
			const slot = slotOf.clientWidth;
			if (slot < PITCH * 8) return 0;
			const cols = Math.floor((slot + 1) / PITCH);
			return cols - (cols % 2);
		};

		const draw = (animate: boolean) => {
			cancelAnimationFrame(frame);
			const cols = gridCols();
			if (!cols) return;

			if (!seed || seed.length !== cols) {
				seed = new Uint8Array(cols);
				if (start === 'random') for (let i = 0; i < cols; i++) seed[i] = Math.random() < 0.5 ? 1 : 0;
				// sempre numa célula par: no bloco-sequencial a paridade da semente muda o
				// desenho, e a paridade não pode depender da largura da tela
				else seed[(cols >> 1) & ~1] = 1;
			}
			const origin = seed;
			const colors = palette();

			// em pixels do dispositivo, arredondados: com zoom ou escala fracionária a
			// malha continua nítida e os vãos, regulares
			const dpr = window.devicePixelRatio || 1;
			const px = (value: number) => Math.round(value * dpr);
			const w = cols * PITCH - 1;
			const h = ROWS * PITCH - 1;

			const jobs = canvases.map((canvas) => {
				const mode: Mode = canvas.dataset.caCanvas === 'block' ? 'block' : 'sync';
				const history = [origin];
				for (let r = 1; r < ROWS; r++) history.push(step(history[r - 1], rule, mode));

				canvas.width = px(w);
				canvas.height = px(h);
				canvas.style.width = `${w}px`;
				canvas.style.height = `${h}px`;
				return { mode, ctx: canvas.getContext('2d'), history };
			});

			const cell = (ctx: CanvasRenderingContext2D, r: number, c: number) => {
				const x = px(c * PITCH);
				const y = px(r * PITCH);
				ctx.fillRect(x, y, px(c * PITCH + CELL) - x, px(r * PITCH + CELL) - y);
			};
			// a malha apagada vem inteira e de uma vez; só as células ativas se revelam
			for (const { ctx } of jobs) {
				if (!ctx) continue;
				ctx.fillStyle = colors.off;
				for (let r = 0; r < ROWS; r++) for (let c = 0; c < cols; c++) cell(ctx, r, c);
			}
			const paint = (from: number, upTo: number) => {
				for (const { ctx, history } of jobs) {
					if (!ctx) continue;
					for (let r = from; r < upTo; r++) {
						ctx.fillStyle = r === 0 ? colors.seed : colors.on;
						for (let c = 0; c < cols; c++) if (history[r][c]) cell(ctx, r, c);
					}
				}
			};

			// o mesmo conteúdo dos diagramas, em palavras
			const historyOf = (mode: Mode) => jobs.find((job) => job.mode === mode)?.history;
			const sync = historyOf('sync');
			const block = historyOf('block');
			if (sync && block) {
				let differ = 0;
				for (let r = 1; r < ROWS; r++) for (let c = 0; c < cols; c++) if (sync[r][c] !== block[r][c]) differ++;
				const share = Math.round((differ / (ROWS * cols)) * 100);
				const next =
					`regra ${rule}, início ${start === 'one' ? 'com uma célula ativa' : 'aleatório'}, ` +
					`anel de ${cols} células, ${ROWS} instantes. no último instante há ` +
					`${count(sync[ROWS - 1])} células ativas na atualização síncrona e ` +
					`${count(block[ROWS - 1])} na bloco-sequencial. os dois diagramas diferem em ${share}% das células.`;
				if (state.textContent !== next) state.textContent = next;
			}

			// no papel e com movimento reduzido não há revelação: o diagrama vem inteiro
			const instant = printing || reduced.matches;
			// fora da tela ainda: só o início, à espera de quem vai ver o resto
			if (!seen && !instant) {
				paint(0, 1);
				return;
			}
			if (!animate || instant) {
				paint(0, ROWS);
				return;
			}
			// o diagrama se desenha de cima para baixo, na ordem em que o tempo passa
			const began = performance.now();
			let done = 0;
			const tick = (now: number) => {
				const t = Math.min(1, (now - began) / REVEAL_MS);
				const target = Math.max(1, Math.round((1 - Math.pow(1 - t, 3)) * ROWS));
				paint(done, target);
				done = target;
				if (t < 1) frame = requestAnimationFrame(tick);
			};
			frame = requestAnimationFrame(tick);
		};

		const press = (selector: string, active: Element) => {
			for (const chip of root.querySelectorAll(selector)) chip.setAttribute('aria-pressed', String(chip === active));
		};
		const interact = () => {
			seen = true;
			draw(true);
		};
		// quem chega aos controles quer ouvir o resultado. a região fica viva antes
		// do clique: mudança feita no mesmo instante em que ela nasce não é anunciada
		const controls = root.querySelector('.controls');
		const listen = () => state.setAttribute('aria-live', 'polite');
		controls?.addEventListener('focusin', listen, { once: true });
		controls?.addEventListener('pointerdown', listen, { once: true });

		for (const chip of root.querySelectorAll<HTMLButtonElement>('[data-ca-rule]')) {
			chip.addEventListener('click', () => {
				rule = Number(chip.dataset.caRule);
				press('[data-ca-rule]', chip);
				interact();
			});
		}
		for (const chip of root.querySelectorAll<HTMLButtonElement>('[data-ca-start]')) {
			chip.addEventListener('click', () => {
				start = chip.dataset.caStart === 'random' ? 'random' : 'one';
				seed = null; // "aleatório" de novo sorteia outro início
				press('[data-ca-start]', chip);
				interact();
			});
		}

		// a largura que conta é a de cada figura: é ela que muda quando os
		// diagramas passam de uma coluna para duas. só redesenha quando a malha
		// muda — a largura varia a cada pixel, o número de colunas não
		new ResizeObserver(() => {
			const cols = gridCols();
			if (cols === drawnCols) return;
			drawnCols = cols;
			draw(false);
		}).observe(slotOf);

		new IntersectionObserver(
			(entries, observer) => {
				if (!entries.some((entry) => entry.isIntersecting)) return;
				observer.disconnect();
				if (seen) return;
				seen = true;
				draw(true);
			},
			{ threshold: 0.35 },
		).observe(slotOf);

		// o canvas não acompanha sozinho o que muda fora dele: tema, papel e densidade de tela
		new MutationObserver(() => draw(false)).observe(document.documentElement, {
			attributes: true,
			attributeFilter: ['data-theme'],
		});
		window.addEventListener('beforeprint', () => {
			printing = true;
			draw(false);
		});
		window.addEventListener('afterprint', () => {
			printing = false;
			draw(false);
		});
		const watchDensity = () => {
			window.matchMedia(`(resolution: ${window.devicePixelRatio || 1}dppx)`).addEventListener(
				'change',
				() => {
					draw(false);
					watchDensity();
				},
				{ once: true },
			);
		};
		watchDensity();
	}
</script>
